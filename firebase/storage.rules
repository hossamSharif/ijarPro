rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Placeholder — full rules will be implemented in Phase 2 (T031)
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
